# =====================================================================
# SWASTHVAANI BACKEND ENVIRONMENT CONFIGURATION
# =====================================================================

# --- Server & Database Settings ---
PORT=8001
HOST=0.0.0.0
CORS_ORIGINS=*
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=swasthvaani

# --- Twilio Telephony & IVR Configuration ---
# Replace these with your actual Twilio Account credentials:
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Public URL where Twilio webhooks are forwarded (e.g. ngrok / cloudflare tunnel / prod domain)
# Example: https://abc-123.ngrok-free.app
PUBLIC_WEBHOOK_URL=

# Set to "false" if testing locally through proxies where Twilio HMAC header check should be bypassed
TWILIO_VALIDATE_SIGNATURE=true

# --- Groq Fast LLM & Speech-to-Text (ASR) ---
# Get your API key from https://console.groq.com
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_ASR_MODEL=whisper-large-v3

# --- LLM Provider Selection ---
# Options: "auto" | "groq" | "ollama" | "emergent"
LLM_PROVIDER=auto

# --- Security & JWT Auth ---
JWT_SECRET=swasthvaani-hackathon-secure-secret-key-2026
JWT_EXPIRATION_HOURS=72

# --- Demo Login Credentials ---
CLINIC_EMAIL=clinic@swasthvaani.health
CLINIC_PASSWORD=clinic123
NGO_EMAIL=ngo@swasthvaani.health
NGO_PASSWORD=ngo123
SUPERADMIN_EMAIL=admin@swasthvaani.health
SUPERADMIN_PASSWORD=admin123
