# =====================================================================
# SWASTHVAANI BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# =====================================================================

# ── Database ────────────────────────────────────────────────────────
# MongoDB connection URI (Atlas connection string or local mongodb://localhost:27017)
# Leave empty to automatically fall back to fast in-memory store for local testing
MONGO_URL=mongodb://localhost:27017
DB_NAME=swasthvaani

# ── Auth & Security ─────────────────────────────────────────────────
# 32+ char secret string used to sign JWT tokens
JWT_SECRET=swasthvaani-secret-jwt-key-2026-change-in-production
JWT_EXPIRATION_HOURS=72

# Hardcoded Demo Login Credentials (for hackathon demo/testing)
CLINIC_EMAIL=clinic@swasthvaani.health
CLINIC_PASSWORD=clinic123

NGO_EMAIL=ngo@swasthvaani.health
NGO_PASSWORD=ngo123

SUPERADMIN_EMAIL=admin@swasthvaani.health
SUPERADMIN_PASSWORD=admin123

# ── CORS & Server ───────────────────────────────────────────────────
PORT=8001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# ── Groq — High-Speed ASR (Whisper) + LLM (Llama 3.3 70B) ──────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_ASR_MODEL=whisper-large-v3

# ── LLM Provider Selection ──────────────────────────────────────────
# Options: "auto" | "groq" | "ollama" | "emergent"
LLM_PROVIDER=auto

# ── ASR Provider Selection ──────────────────────────────────────────
# Options: "auto" | "groq" | "whisper_local" | "openai"
ASR_PROVIDER=auto

# ── Local Ollama (Optional, offline local LLM) ──────────────────────
# Run: ollama pull nemotron-mini or ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nemotron-mini

# ── Local Whisper ASR (Optional, local speech recognition) ───────────
# Options: tiny | base | small | medium
WHISPER_MODEL=small

# ── Optional Fallback LLM / TTS APIs ────────────────────────────────
# Emergent Integrations / OpenAI key
EMERGENT_LLM_KEY=

# Anthropic Claude key
ANTHROPIC_API_KEY=

# Kokoro TTS (local onnx TTS)
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
KOKORO_VOICE=hf_alpha

# ── Twilio Telephony & IVR Configuration ────────────────────────────
# Get credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Optional Twilio API Keys
TWILIO_API_KEY=SKXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_SECRET=your_twilio_api_secret_here
TWILIO_TWIML_APP_SID=APXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Public URL where Twilio webhooks are forwarded (ngrok / Cloudflare tunnel / domain)
PUBLIC_WEBHOOK_URL=https://your-tunnel-subdomain.trycloudflare.com
TWILIO_VALIDATE_SIGNATURE=true
