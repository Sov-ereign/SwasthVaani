MONGO_URL=mongodb://localhost:27017
DB_NAME=swasthvaani

# ── LLM / STT / TTS ──────────────────────────────────────────────
# Replace with your real key to enable LLM triage + OpenAI Whisper + TTS
# Get from: emergentintegrations dashboard  OR  platform.openai.com
EMERGENT_LLM_KEY=YOUR_OPENAI_OR_EMERGENT_KEY_HERE

# Optional: Claude as LLM backend — console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE

# Optional: Groq (fast free LLM) — console.groq.com
GROQ_API_KEY=YOUR_GROQ_KEY_HERE

# ── Local Ollama (free, no key needed) ───────────────────────────
# Run: ollama pull llama3.2   then set model name below
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nemotron-mini

# ── Local Whisper ASR ────────────────────────────────────────────
# Options: tiny, base, small, medium (tiny = fastest, small = best for demo)
WHISPER_MODEL=small

# ── Kokoro TTS (local, offline) ──────────────────────────────────
# Leave blank if model files not downloaded — falls back to OpenAI TTS
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
KOKORO_VOICE=hf_alpha

# ── Auth / Security ──────────────────────────────────────────────
JWT_SECRET=swasthvaani-secret-jwt-key-2026-change-in-prod
CLINIC_EMAIL=clinic@swasthvaani.health
CLINIC_PASSWORD=clinic123

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
